{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "line-select-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "line-select-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "bundle-analyzer",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "experimental-analyze",
        "--port",
        "4000"
      ],
      "port": 4000
    }
  ]
}